    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "cookie": "^0.7.0",
    "zod": "^3.23.0",
    "drizzle-orm": "^0.35.0",
    "postgres": "^3.4.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "bcrypt": "^5.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/cookie": "^0.6.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@sprintio/tsconfig": "workspace:*"
  }
