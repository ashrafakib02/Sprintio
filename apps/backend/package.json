{
  "name": "@sprintio/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "pnpm --filter @sprintio/db --filter @sprintio/shared build && tsc --noEmit"
  },
  "dependencies": {
    "@sprintio/db": "workspace:*",
    "@sprintio/shared": "workspace:*",
    "bcrypt": "^5.1.0",
    "compression": "^1.7.4",
    "cookie": "^0.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "ua-parser-js": "^2.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@sprintio/tsconfig": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/ua-parser-js": "^0.7.39",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
